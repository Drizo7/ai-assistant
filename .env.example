# Which tenant config to load (config/tenants/<TENANT>.json) and its content folder
TENANT=amt

# SQLite file (created on first run)
DB_PATH=data/assistant.sqlite

PORT=8000

# Model provider: extractive | anthropic | ollama
#   extractive = no model at all; quotes the best approved passage. Use for tests and offline demos.
LLM_PROVIDER=extractive

# Anthropic (hosted). The SDK also picks up an `ant auth login` profile if no key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Ollama (local, same LAN as medeorag today)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Staff-only admin endpoints require this bearer token. Leave empty to disable /admin.
ADMIN_TOKEN=

# Optional: POST each new handoff as JSON to this URL (e.g. a mail relay, n8n, Slack webhook)
HANDOFF_WEBHOOK_URL=

# buffered (default, safer: post-check runs before any text reaches the visitor) | live
STREAM_MODE=buffered
